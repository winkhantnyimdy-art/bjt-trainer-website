# QA / tooling output
.qa/
out/
*.log

# Dependencies (the site itself has none; the dev tools do)
node_modules/

# The signed release APK.
#
# BJT-Trainer-1.0.0.apk is 154,375,447 bytes = 147.24 MiB. GitHub hard-blocks
# any git object over 100 MiB, so tracking it would make this repository
# impossible to push to GitHub at all (Pages included).
#
# The APK is therefore published as a GitHub Release *asset* instead, which is
# an attachment rather than a git object and is capped at 2 GB. The local copy
# in downloads/ is kept for verification and is intentionally untracked.
#
# The verified file:
#   size   154375447
#   sha256 222F2650444A64910D3AD42A422035D86EAD4C23C8F7ADF42865A4F01BF020F6
downloads/

# The staged Flutter Web/PWA build.
#
# ./app/ is never committed — same policy as downloads/ above, since it is
# ~135 MB of generated files. It is staged locally from the verified Flutter
# release build and published by a manual/CLI deploy of this folder; see the
# top of netlify.toml for the exact model. tools/fetch-pwa.sh is an opt-in
# helper that can re-materialize ./app/ from the pinned release ZIP and is
# deliberately NOT part of the default build command.
app/
*.zip

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Local Netlify folder
.netlify
